import random

class Number:
    def __init__(self, a, b):
        self.__a = a
        self.__b = b

    def __calculate(self):
        operation = random.choice(["+", "-", "*"])

        if operation == "+":
            return self.__a + self.__b
        elif operation == "-":
            return self.__a - self.__b
        else:
            return self.__a * self.__b

    def __str__(self):
        return str(self.__calculate())

a = int(input("Введіть перше число: "))
b = int(input("Введіть друге число: "))

number = Number(a, b)

print("Результат:", number)
