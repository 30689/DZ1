import random

number = random.randint(1, 10)

for attempt in range(3):
    guess = int(input("вгадайте число від 1 до 10: "))

    if guess == number:
        print("ви вгадали")
        break
    elif guess > number:
        print("менше")
    else:
        print("більше")
else:
    print(f"ви не вгадали. Було загадано число {number}.")
